# 本地 HTTP 开发保持 development；HTTPS 生产部署必须改为 production。
NODE_ENV=development
HOST=127.0.0.1
PORT=9527
SERVER_NAME=LX Sync
DATABASE_URL=postgresql://lx_sync:change-this-database-password@127.0.0.1:5432/lx_sync
MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
SESSION_TTL_HOURS=24
MAX_SNAPSHOTS=10
TRUST_PROXY=false
PUBLIC_ORIGIN=http://localhost:9527
LOG_LEVEL=info
POSTGRES_PASSWORD=change-this-database-password

# 本地运行 Vite 时改为 http://localhost:5173。
# 仅在自定义静态资源目录时设置：WEB_DIST_PATH=/absolute/path/to/apps/web/dist
