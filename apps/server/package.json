{
  "name": "@lx-sync/server",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node -e \"if (!process.env.TEST_DATABASE_URL) throw new Error('TEST_DATABASE_URL is required'); if (process.env.ALLOW_TEST_DATABASE_WRITE !== '1') throw new Error('ALLOW_TEST_DATABASE_WRITE=1 is required')\" && vitest run src/protocol.integration.test.ts src/tools/lxserver-v2-import.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.0",
    "fastify": "5.10.0",
    "kysely": "0.29.4",
    "message2call": "0.1.3",
    "pg": "8.22.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
