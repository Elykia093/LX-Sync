{
  "name": "lx-sync",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted LX Music sync service with PostgreSQL persistence.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --filter @lx-sync/server dev",
    "dev:web": "pnpm --filter @lx-sync/web dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
